  {
    "description": "Set run mode to staging (GK <= 6.5.x path)",
    "file": "static/mode.js",
    "required": false,
    "skipIfPresent": "staging",
    "find": "module\\.exports = ['\"]production['\"];",
    "replace": "module.exports = 'staging';"
  },
  {
    "description": "Set run mode to staging (GK 7.x+ path)",
    "file": "src/main/static/mode.js",
    "skipIfPresent": "staging",
    "find": "module\\.exports = ['\"]production['\"];",
    "replace": "module.exports = 'staging';"
  }
]
